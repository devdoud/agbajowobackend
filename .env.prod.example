# Modèle d'environnement de PRODUCTION. Copier en .env sur le serveur et remplir.
# ⚠️ Générer de vrais secrets (openssl rand -base64 48). Ne jamais committer .env.

# ─── Application ───────────────────────────────
NODE_ENV=production
PORT=3001
CORS_ORIGIN=https://app.mon-domaine.com   # origine exacte du frontend
DOMAIN=api.mon-domaine.com                # domaine de l'API (Caddy → HTTPS)

# ─── PostgreSQL (host = service compose « postgres ») ───
POSTGRES_USER=agbajowo
POSTGRES_PASSWORD=CHANGER_MOI_mot_de_passe_fort
POSTGRES_DB=agbajowo
DATABASE_URL=postgresql://agbajowo:CHANGER_MOI_mot_de_passe_fort@postgres:5432/agbajowo?schema=public
DIRECT_URL=postgresql://agbajowo:CHANGER_MOI_mot_de_passe_fort@postgres:5432/agbajowo?schema=public

# ─── Authentification JWT (secrets forts, distincts) ───
JWT_ACCESS_SECRET=CHANGER_MOI_secret_access_48+
JWT_REFRESH_SECRET=CHANGER_MOI_secret_refresh_48+
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# ─── Médias ────────────────────────────────────
MEDIA_DIR=/app/media
MEDIA_MAX_BYTES=2097152

# ─── Documentation Swagger ─────────────────────
# Éteinte en prod : elle publie la carte complète de l'API. Mettre true seulement le
# temps d'une intervention.
SWAGGER_ENABLED=false

# ─── Proxy et photos (spec 0004) ───────────────
# Pile VPS : Caddy est le seul proxy, les photos vont dans le volume media-data.
# Sur Render et Supabase, les valeurs sont dans render.yaml et docs/exploitation/mise-en-ligne.md.
TRUST_PROXY=1
MEDIA_DRIVER=disque
