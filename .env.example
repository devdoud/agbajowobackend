# ─────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:3000

# ─────────────────────────────────────────────
# Base de données PostgreSQL (utilisée dès le lot L1)
# ─────────────────────────────────────────────
DATABASE_URL=postgresql://agbajowo:agbajowo@localhost:5432/agbajowo?schema=public
# Migrations : la même base en local (sur Supabase : le pooler en mode session, port 5432).
DIRECT_URL=postgresql://agbajowo:agbajowo@localhost:5432/agbajowo?schema=public
POSTGRES_USER=agbajowo
POSTGRES_PASSWORD=agbajowo
POSTGRES_DB=agbajowo
POSTGRES_PORT=5432

# ─────────────────────────────────────────────
# Authentification JWT (lot L2)
# Remplacer par des secrets forts en production.
# ─────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# ─────────────────────────────────────────────
# Médias / photos (lot L4)
# ─────────────────────────────────────────────
MEDIA_DIR=./media
MEDIA_MAX_BYTES=2097152

# ─────────────────────────────────────────────
# Documentation Swagger (/api/v1/docs, JSON sur /api/v1/docs-json)
# ─────────────────────────────────────────────
SWAGGER_ENABLED=true

# ─────────────────────────────────────────────
# Proxy et stockage des photos (spec 0004)
# ─────────────────────────────────────────────
# Nombre de proxys de confiance devant l'API (0 en local, 1 sur Render ou derrière Caddy).
TRUST_PROXY=0
# disque (local) ou s3 (Supabase Storage, voir docs/exploitation/mise-en-ligne.md).
MEDIA_DRIVER=disque
